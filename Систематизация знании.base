filters:
  and:
    - file.folder != "Другое"
formulas:
  Untitled: file.ctime.relative()
properties:
  formula.Untitled:
    displayName: Time passed since creation
views:
  - type: table
    name: Table
    filters:
      and:
        - file.folder != "Другое/Задачи"
        - file.folder != "Картинки"
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.tags
      - file.ctime
      - formula.Untitled
    sort:
      - property: formula.Untitled
        direction: DESC
      - property: file.mtime
        direction: DESC
    columnSize:
      file.tags: 145
  - type: cards
    name: View

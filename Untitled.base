filters:
  and:
    - file.folder != "Другое"
formulas:
  Untitled: ""
  Untitled 2: ""
views:
  - type: table
    name: Table
    filters:
      and:
        - file.folder != "Другое/Задачи"
        - file.folder != "Картинки"
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.ctime
      - file.tags
      - formula.Untitled
      - formula.Untitled 2
    sort:
      - property: file.mtime
        direction: DESC

filters:
  and:
    - file.folder != "Другое"
formulas:
  Untitled: date(YYYY-MM-DD)
views:
  - type: table
    name: Table
    filters:
      and:
        - file.folder != "Другое/Задачи"
        - file.folder != "Картинки"
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.ctime
      - file.tags
      - formula.Untitled
    sort:
      - property: formula.Untitled
        direction: DESC
      - property: file.mtime
        direction: DESC
